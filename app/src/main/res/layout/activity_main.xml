<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        app:liftOnScroll="true">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:titleCollapseMode="scale"
            style="@style/Widget.Material3.CollapsingToolbar.Large">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin"
                app:menu="@menu/main"
                app:title="@string/app_name" />
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="120dp">

            <!-- Status ==================================================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/statusCard"
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                app:cardCornerRadius="16dp"
                app:contentPadding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/statusIcon"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="14dp"
                            android:background="?attr/colorPrimaryContainer"
                            android:padding="8dp"
                            android:src="@drawable/ic_translate"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.HookTrans.Circle"
                            app:tint="?attr/colorOnPrimaryContainer" />

                        <TextView
                            android:id="@+id/statusTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="?attr/textAppearanceTitleLarge"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/statusSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingMultiplier="1.15"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/cacheInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.HookTrans.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:contentPaddingLeft="12dp"
                app:contentPaddingRight="12dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swEnabled"
                    style="@style/Widget.HookTrans.Switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/master_enable"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Languages ================================================= -->
            <TextView
                style="@style/Widget.HookTrans.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_languages" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.HookTrans.Dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/label_source_lang"
                app:startIconDrawable="@drawable/ic_language">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/ddSource"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    app:simpleItemLayout="@layout/item_dropdown" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.HookTrans.Dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="@string/label_target_lang"
                app:startIconDrawable="@drawable/ic_translate">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/ddTarget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    app:simpleItemLayout="@layout/item_dropdown" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Engine ==================================================== -->
            <TextView
                style="@style/Widget.HookTrans.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_engine" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.HookTrans.Dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/label_engine"
                app:startIconDrawable="@drawable/ic_cloud">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/ddEngine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    app:simpleItemLayout="@layout/item_dropdown" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEndpoint"
                style="@style/Widget.HookTrans.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="@string/label_endpoint"
                app:placeholderText="@string/hint_endpoint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEndpoint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilApiKey"
                style="@style/Widget.HookTrans.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="@string/label_api_key"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etApiKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelfTest"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/action_self_test"
                    app:icon="@drawable/ic_check" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDownloadModel"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/action_download_model"
                    app:icon="@drawable/ic_download" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/testResultCard"
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorSecondaryContainer"
                app:cardCornerRadius="12dp"
                app:contentPadding="14dp">

                <TextView
                    android:id="@+id/testResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSecondaryContainer"
                    android:textIsSelectable="true" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Apps ====================================================== -->
            <TextView
                style="@style/Widget.HookTrans.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_scope" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.HookTrans.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:contentPaddingBottom="12dp"
                app:contentPaddingLeft="12dp"
                app:contentPaddingRight="12dp"
                app:contentPaddingTop="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swAllApps"
                        style="@style/Widget.HookTrans.Switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/scope_all_apps" />

                    <TextView
                        style="@style/Widget.HookTrans.RowSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/scope_all_apps_sub" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPickApps"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pick_apps"
                        app:icon="@drawable/ic_apps" />

                    <TextView
                        android:id="@+id/appsSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Coverage ================================================== -->
            <TextView
                style="@style/Widget.HookTrans.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_coverage" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.HookTrans.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:contentPaddingBottom="4dp"
                app:contentPaddingLeft="12dp"
                app:contentPaddingRight="12dp"
                app:contentPaddingTop="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swTextViews"
                        style="@style/Widget.HookTrans.Switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hook_textviews" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swHints"
                        style="@style/Widget.HookTrans.Switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hook_hints" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swWebViews"
                        style="@style/Widget.HookTrans.Switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hook_webviews" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swCompose"
                        style="@style/Widget.HookTrans.Switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hook_compose" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="2dp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swCanvas"
                        style="@style/Widget.HookTrans.Switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hook_canvas" />

                    <TextView
                        style="@style/Widget.HookTrans.RowSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hook_canvas_sub" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="2dp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swImages"
                        style="@style/Widget.HookTrans.Switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hook_images" />

                    <TextView
                        style="@style/Widget.HookTrans.RowSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hook_images_sub" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swOverlayShowOriginal"
                        style="@style/Widget.HookTrans.Switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="@string/overlay_show_original" />

                    <TextView
                        style="@style/Widget.HookTrans.RowSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="@string/overlay_show_original_sub" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swPrefetch"
                        style="@style/Widget.HookTrans.Switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/prefetch_parsed" />

                    <TextView
                        style="@style/Widget.HookTrans.RowSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/prefetch_parsed_sub" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="2dp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swResources"
                        style="@style/Widget.HookTrans.Switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hook_resources" />

                    <TextView
                        style="@style/Widget.HookTrans.RowSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hook_resources_sub" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Safety ==================================================== -->
            <TextView
                style="@style/Widget.HookTrans.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_safety" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.HookTrans.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:contentPaddingBottom="4dp"
                app:contentPaddingLeft="12dp"
                app:contentPaddingRight="12dp"
                app:contentPaddingTop="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swMaxCompat"
                        style="@style/Widget.HookTrans.Switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/max_compat" />

                    <TextView
                        style="@style/Widget.HookTrans.RowSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/max_compat_sub" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swSkipLinked"
                        style="@style/Widget.HookTrans.Switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/skip_linked" />

                    <TextView
                        style="@style/Widget.HookTrans.RowSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/skip_linked_sub" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swSelectable"
                        style="@style/Widget.HookTrans.Switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/translate_selectable" />

                    <TextView
                        style="@style/Widget.HookTrans.RowSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/translate_selectable_sub" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Advanced ================================================== -->
            <TextView
                style="@style/Widget.HookTrans.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_advanced" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.HookTrans.TextField"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:hint="@string/label_min_chars">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etMinChars"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.HookTrans.TextField"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/label_max_chars">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etMaxChars"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.HookTrans.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="@string/label_exclude_ids"
                app:helperText="@string/hint_exclude_ids">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etExcludeIds"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textNoSuggestions"
                    android:maxLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.HookTrans.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="@string/label_never_translate"
                app:helperText="@string/hint_never_translate">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNeverTranslate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:minLines="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.HookTrans.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:contentPaddingBottom="4dp"
                app:contentPaddingLeft="12dp"
                app:contentPaddingRight="12dp"
                app:contentPaddingTop="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swVerbose"
                        style="@style/Widget.HookTrans.Switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/log_verbose" />

                    <TextView
                        style="@style/Widget.HookTrans.RowSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/log_verbose_sub" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearCache"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/action_clear_cache"
                app:icon="@drawable/ic_delete" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/btnSave"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="@string/action_save"
        app:icon="@drawable/ic_save" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
